ROUTE_POLL_INTERVAL = 2  # polling interval
RESOURCE_AGENT_START_TIMEOUT = 240
RESOURCE_AGENT_STOP_TIMEOUT = 120
RESOURCE_AGENT_MONITOR_TIMEOUT = 30
RESOURCE_AGENT_INTERVAL = 60
RESOURCE_AGENT_TIMEOUT_BUFFER = 5
RESOURCE_AGENT_OPTIONS = (
    "ip",
    "api_key",
    "api_type",
    "region",
