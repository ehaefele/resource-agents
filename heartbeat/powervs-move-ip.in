class OCFExitError(Exception):
    """OCF exit wrapper. Calls sys.exit() immediately on construction — never actually raises.

    Subclasses are instantiated with `raise` for call-stack readability only.
    """

    def __init__(self, message, exit_code):
        self.exit_code = exit_code
        ocf.ocf_exit_reason(message)
        sys.exit(exit_code)


class CmdError(OCFExitError):
    """Exception class for errors when running system commands."""

    def __init__(self, message, exit_code):
        super().__init__(f"[CmdError] {message}", exit_code)


def os_cmd(cmd_args, is_json=False, is_text=False, timeout=10):
    """Run a system command and optionally parse JSON output or return text.

    Returns:
        When is_json=True: list or dict (parsed JSON data)
        When is_text=True: str (stdout text, stripped)
        When both False: int (return code)
    """
    ocf.logger.debug(f"[os_cmd]: args: {cmd_args}")
    try:
        result = subprocess.run(
            cmd_args,
            capture_output=True,
            text=True,
            check=True,
            timeout=timeout,
            env={"LANG": "C"},
        )
        if is_json:
            if not result.stdout.strip():
                return []
            try:
                parsed = json.loads(result.stdout)
                return parsed if parsed is not None else []
            except json.JSONDecodeError as e:
                raise CmdError(f"os_cmd: JSON parsing failed: {e}", ocf.OCF_ERR_GENERIC)
        if is_text:
            return result.stdout.strip()
        return result.returncode

    except subprocess.CalledProcessError as e:
        raise CmdError(
            f"os_cmd: command failed: {e.stderr}",
            ocf.OCF_ERR_GENERIC,
        )
    except subprocess.TimeoutExpired:
        raise CmdError("os_cmd: command timed out", ocf.OCF_ERR_GENERIC)


def ip_cmd(*args, is_json=False):
    """Generic wrapper for the ip command."""
    return os_cmd([IP_CMD] + list(args), is_json=is_json)


def ip_address_show():
    """Show IP addresses in JSON format."""
    return ip_cmd("-json", "address", "show", is_json=True)


def ip_address_add(cidr, device, label=None):
    """Add an IP address to a device."""
    cmd = ["address", "add", cidr, "dev", device]
    if label:
        cmd += ["label", label]
    return ip_cmd(*cmd)


def ip_address_delete(cidr, device):
    """Delete an IP address from a device."""
    return ip_cmd("address", "delete", cidr, "dev", device)


def ip_find_device(ip):
    """Find the device associated with a given IP address."""
    for iface in ip_address_show():  # type: ignore[misc]
        addresses = [a["local"] for a in iface["addr_info"]]
        if ip in addresses and "UP" in iface["flags"]:
            return iface["ifname"]

    return None


def ip_check_device(device, ip):
    """Verify that a device with the specified interface name (device) exists,
    has the ip address assigned to it, and is UP
    """
    for iface in ip_address_show():  # type: ignore[misc]
        addresses = [a["local"] for a in iface["addr_info"]]
        if iface["ifname"] == device and ip in addresses and "UP" in iface["flags"]:
            return True

    return False


def ip_alias_add(ip, device, label=None):
    """Add an IP alias to the given device."""

    ip_cidr = f"{ip}/{CIDR_NETMASK}"

    dev = ip_find_device(ip)
    if dev:
        if dev != device:
            ocf.logger.error(
                f"[ip_alias_add]: IP alias '{ip_cidr}' "
                f"already set on wrong interface '{dev}', instead of '{device}'"
            )
            raise CmdError(
                "ip_alias_add: device configuration mismatch", ocf.OCF_ERR_CONFIGURED
            )

        ocf.logger.debug(
            f"[ip_alias_add]: IP alias '{ip_cidr}' already set on interface '{device}'"
        )
        return

    ocf.logger.debug(
        f"[ip_alias_add]: adding IP alias '{ip_cidr}' "
        f"with label '{label}' to interface '{device}'"
    )
    ip_address_add(ip_cidr, device, label)


def ip_alias_remove(ip):
    """Find the device with the given IP alias and remove the alias."""
    device = ip_find_device(ip)
    if device:
        ip_cidr = f"{ip}/{CIDR_NETMASK}"
        ocf.logger.debug(
            f"[ip_alias_remove]: removing IP alias '{ip_cidr}' "
            f"from interface '{device}'"
        )
        ip_address_delete(ip_cidr, device)


def create_session_with_retries():
    """Create a request session with a retry strategy."""
    retry_strategy = urllib3.util.Retry(
        total=HTTP_MAX_RETRIES,
        status_forcelist=HTTP_STATUS_FORCE_RETRIES,
        allowed_methods=HTTP_RETRY_ALLOWED_METHODS,
        backoff_factor=HTTP_BACKOFF_FACTOR,
        raise_on_status=False,
    )
    adapter = requests.adapters.HTTPAdapter(max_retries=retry_strategy)
    session = requests.Session()
    session.mount("https://", adapter)
    session.mount("http://", adapter)
    return session


class PowerCloudTokenManagerError(OCFExitError):
    """Exception class for errors in the PowerCloudTokenManager."""

    def __init__(self, message, exit_code):
        super().__init__(f"[PowerCloudTokenManagerError] {message}", exit_code)


class PowerCloudTokenManager:
    """Request and cache IBM Cloud tokens."""

    _TOKEN_REFRESH_BUFFER = 900  # 15 minutes (in seconds)
    _DEFAULT_TOKEN_EXPIRY = 300  # Default token expiry (5 minutes)
    _IBMCLOUD_METADATA_ENDPOINT = "https://api.metadata.power-iaas.cloud.ibm.com"
    _ALLOWED_PROFILE_SELECTORS = frozenset({"id", "name"})

    def __init__(
        self,
        api_type="",
        api_key="",
        proxy="",
        profile="",
        use_cache=False,
    ):
        """Initialize PowerCloudTokenManager."""
        self._use_trusted_profile, self._trusted_profile_data, self._api_key = (
            self._parse_auth_config(api_key, profile)
        )
        self._auth_url = (
            self._IBMCLOUD_METADATA_ENDPOINT
            if self._use_trusted_profile
            else self._get_auth_url(api_type)
        )
        self._cache_file = self._setup_token_cache_file() if use_cache else None
        self._proxy = {"https": proxy} if proxy else None
        self._session = create_session_with_retries()

    @staticmethod
    def _get_auth_url(api_type):
        """Determine IAM token endpoint based on API type."""
        iam_subdomain = "private." if api_type == "private" else ""
        return f"https://{iam_subdomain}{IAM_CLOUD_DOMAIN}/identity/token"

    def _parse_auth_config(self, api_key, profile):
        """Parse authentication configuration from api_key and profile parameters.

        Supports multiple authentication modes:
        - API key: plain string or @file path
        - Identity token with trusted profile:
          * api_key == "identity_token" and empty profile → use default trusted profile
          * profile == "id:profile-id" → select profile by ID
          * profile == "name:profile-name" → select profile by name

        Returns:
            tuple: (use_trusted_profile, trusted_profile_data, api_key_value)
                - use_trusted_profile: bool flag indicating trusted profile mode
                - trusted_profile_data: dict with trusted profile info or empty dict
                - api_key_value: loaded API key string or None if using trusted profile
        """
        api_key_str = str(api_key).strip() if api_key else ""
        profile_str = str(profile).strip() if profile else ""

        if api_key_str.lower() == "identity_token":
            if not profile_str:
                return True, {}, None

            if ":" not in profile_str:
                raise PowerCloudTokenManagerError(
                    f"_parse_auth_config: Malformed trusted profile selector: '{profile_str}'. "
                    f"Valid formats: 'id:VALUE', 'name:VALUE'",
                    ocf.OCF_ERR_CONFIGURED,
                )
            prefix, _, value = profile_str.partition(":")
            value = value.strip()
            if not value:
                raise PowerCloudTokenManagerError(
                    f"_parse_auth_config: Empty value in trusted profile selector: '{profile_str}'. "
                    f"Expected format: '{prefix}:VALUE'",
                    ocf.OCF_ERR_CONFIGURED,
                )

            prefix_lower = prefix.lower()
            if prefix_lower in self._ALLOWED_PROFILE_SELECTORS:
                return True, {"trusted_profile": {prefix_lower: value}}, None

            raise PowerCloudTokenManagerError(
                f"_parse_auth_config: Invalid trusted profile selector: '{profile_str}'. "
                f"Valid prefixes are: 'id:', 'name:'",
                ocf.OCF_ERR_CONFIGURED,
            )

        return False, {}, self._load_api_key(api_key)

    def _load_api_key(self, api_key):
        """Load API key from string or file (@path supports raw or JSON with 'apikey')."""
        if not api_key:
            raise PowerCloudTokenManagerError(
                "_load_api_key: API key is missing",
                ocf.OCF_ERR_CONFIGURED,
            )
        if not api_key.startswith("@"):
            return api_key

        api_key_path = Path(api_key[1:])
        if not api_key_path.is_file():
            raise PowerCloudTokenManagerError(
                f"_load_api_key: API key file not found: '{api_key_path}'",
                ocf.OCF_ERR_ARGS,
            )

        mode = stat.S_IMODE(api_key_path.stat().st_mode)
        if mode & 0o077:
            raise PowerCloudTokenManagerError(
                f"_load_api_key: insecure permissions on API key file '{api_key_path}'",
                ocf.OCF_ERR_ARGS,
            )

        content = api_key_path.read_text().strip()
        try:
            api_key_field = json.loads(content).get("apikey", "")
        except json.JSONDecodeError:
            api_key_field = content

        if not api_key_field:
            raise PowerCloudTokenManagerError(
                f"_load_api_key: invalid API key in file '{api_key_path}'",
                ocf.OCF_ERR_ARGS,
            )
        return api_key_field

    def _request_new_token(self):
        """Request a new access token, delegating to the selected acquisition method."""
        if self._use_trusted_profile:
            return self._request_bearer_token_by_identity()
        return self._request_bearer_token_by_apikey()

    def _request_bearer_token_by_apikey(self):
        """Request a new bearer token by using an API key grant."""
        headers = {
            "content-type": "application/x-www-form-urlencoded",
            "accept": "application/json",
        }
        data = {
            "grant_type": "urn:ibm:params:oauth:grant-type:apikey",
            "apikey": self._api_key,
        }
        current_time = time.monotonic()
        try:
            response = self._session.post(
                self._auth_url,
                headers=headers,
                data=data,
                proxies=self._proxy,
                timeout=REQUESTS_TIMEOUT,
            )
            response.raise_for_status()
            token_data = response.json()
            return (
                token_data["access_token"],
                current_time + token_data["expires_in"],
            )
        except requests.RequestException as e:
            ocf.logger.warning(
                "[PowerCloudTokenManager] _request_bearer_token_by_apikey: "
                f"failed to request token: '{e}'"
            )
            return None

    def _identity_service_request(self, method, url, headers, json=None):
        """Send a request to the PowerVS Identity Token Service."""
        response = self._session.request(
            method,
            url,
            headers=headers,
            json=json,
            proxies=None,
            timeout=REQUESTS_TIMEOUT,
        )
        response.raise_for_status()
        return response.json()

    def _request_identity_token(self):
        """Request an identity token from the instance metadata service."""
        identity_url = f"{self._auth_url}/identity/v1/token"
        identity_headers = {"Metadata-Flavor": "ibm"}

        try:
            identity_data = self._identity_service_request(
                "PUT",
                identity_url,
                identity_headers,
                json={},
            )
            identity_token = identity_data.get("access_token")
            if not identity_token:
                ocf.logger.warning(
                    "[PowerCloudTokenManager] _request_identity_token: "
                    "identity token missing in response"
                )
                return None
            return identity_token
        except requests.RequestException as e:
            ocf.logger.warning(
                "[PowerCloudTokenManager] _request_identity_token: "
                f"failed to obtain identity token: '{e}'"
            )
            return None

    def _request_bearer_token_by_identity(self):
        """
        Exchange an identity token for a bearer token by using the instance metadata service.

        Returns:
            tuple: (access_token, expiry_time) or None if the request fails.
        """
        identity_token = self._request_identity_token()
        if not identity_token:
            return None

        iam_token_url = f"{self._auth_url}/identity/v1/iam_tokens"
        iam_token_headers = {
            "Authorization": f"Bearer {identity_token}",
            "Metadata-Flavor": "ibm",
        }
        current_time = time.monotonic()
        try:
            token_data = self._identity_service_request(
                "POST",
                iam_token_url,
                iam_token_headers,
                json=self._trusted_profile_data,
            )
            expires_in = int(token_data.get("expires_in", self._DEFAULT_TOKEN_EXPIRY))
            return (
                token_data["access_token"],
                current_time + expires_in,
            )
        except requests.RequestException as e:
            ocf.logger.warning(
                "[PowerCloudTokenManager] _request_bearer_token_by_identity: "
                f"failed to request bearer token: '{e}'"
            )
            return None

    def _setup_token_cache_file(self):
        """Create a token cache file with secure permissions and return a Path object."""
        cache_file = Path(
            f"@HA_VARRUNDIR@/resource-agents/{OCF_RESOURCE_INSTANCE}-token.json"
        )
        cache_file.parent.mkdir(parents=True, exist_ok=True)
        try:
            fd = os.open(cache_file, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            os.close(fd)
        except FileExistsError:
            pass
        return cache_file

    def _read_cache(self):
        """Read token cache."""
        if self._cache_file is None:
            return {}
        try:
            with self._cache_file.open("r") as f:
                fcntl.flock(f, fcntl.LOCK_SH)
                try:
                    content = f.read().strip()
                    if not content:
                        return {}
                    return json.loads(content)
                finally:
                    fcntl.flock(f, fcntl.LOCK_UN)
        except (json.JSONDecodeError, FileNotFoundError, PermissionError) as e:
            ocf.logger.warning(
                "[PowerCloudTokenManager] _read_cache: failed to read token "
                f"cache due to missing file or malformed JSON: '{e}'"
            )
            return {}

    def _write_cache(self, token, expiration):
        """Write token cache."""
        if self._cache_file is None:
            return
        data = json.dumps({"token": token, "expiration": expiration})
        fd, tmp_path = tempfile.mkstemp(dir=self._cache_file.parent)
        try:
            with os.fdopen(fd, "w") as f:
                os.fchmod(f.fileno(), 0o600)
                f.write(data)
            Path(tmp_path).replace(self._cache_file)
        except OSError as e:
            Path(tmp_path).unlink(missing_ok=True)
            raise PowerCloudTokenManagerError(
                f"_write_cache: failed to write token cache file: '{e}'",
                ocf.OCF_ERR_GENERIC,
            )

    def _is_token_expired(self, expiration):
        """Check if token is expired or near expiry."""
        return time.monotonic() + self._TOKEN_REFRESH_BUFFER >= expiration

    def get_token(self):
        """Get a valid access token, using cache if enabled. Returns a bearer token."""
        if not self._cache_file:
            result = self._request_new_token()
            if result:
                token, _ = result
                return token
            raise PowerCloudTokenManagerError(
                "get_token: token request failed and no cache available",
                ocf.OCF_ERR_GENERIC,
            )

        cache = self._read_cache()
        token = cache.get("token")
        expiration = cache.get("expiration", 0)

        if not token or self._is_token_expired(expiration):
            result = self._request_new_token()
            if result:
                token, expiration = result
                ocf.logger.debug("[PowerCloudTokenManager] get_token: refreshed token")
                self._write_cache(token, expiration)
            else:
                ocf.logger.error(
                    "[PowerCloudTokenManager] get_token: failed to refresh token"
                )
                if token and time.monotonic() < expiration:
                    ocf.logger.warning(
                        "[PowerCloudTokenManager] get_token: using cached token as fallback"
                    )
                else:
                    raise PowerCloudTokenManagerError(
                        "get_token: no valid token available",
                        ocf.OCF_ERR_GENERIC,
                    )
        return token


class PowerCloudAPIError(OCFExitError):
    """Exception class for errors in PowerCloudAPI."""

    def __init__(self, message, exit_code):
        super().__init__(f"[PowerCloudAPIError] {message}", exit_code)


class PowerCloudAPI:
    """Offers a convenient method for sending requests to the IBM Power Cloud API."""

    _ALLOWED_API_TYPES = frozenset({"public", "private"})

    def __init__(
        self,
        api_key="",
        api_type="",
        region="",
        proxy="",
        profile="",
        use_cache=False,
    ):
        """Initialize PowerCloudAPI: resolve endpoint URL, obtain a bearer token, and create an HTTP session."""
        self._proxy = self._get_proxy(proxy)
        self._api_url = self._get_api_url(region, api_type)
        self._token_manager = PowerCloudTokenManager(
            api_type=api_type,
            api_key=api_key,
            proxy=proxy,
            profile=profile,
            use_cache=use_cache,
        )
        self._token = self._token_manager.get_token()
        self._session = create_session_with_retries()

    def _get_proxy(self, proxy):
        """Validate a proxy URL and test TCP connectivity. Returns a proxy dict if reachable."""
        if not proxy:
            return None

        parsed_url = urlparse(proxy)
        is_valid_url = (
            parsed_url.hostname
            and parsed_url.port
            and parsed_url.scheme in ("http", "https")
        )

        if not is_valid_url:
            raise PowerCloudAPIError(
                f"_get_proxy: invalid proxy URL '{proxy}'",
                ocf.OCF_ERR_CONFIGURED,
            )

        try:
            with socket.create_connection(
                (parsed_url.hostname, parsed_url.port), timeout=REQUESTS_CONNECT_TIMEOUT
            ):
                return {"http": proxy, "https": proxy}
        except OSError as e:
            raise PowerCloudAPIError(
                f"_get_proxy: cannot connect to proxy '{proxy}': {e}",
                ocf.OCF_ERR_ARGS,
            )

    def _get_api_url(self, region, api_type):
        """Build and return the PowerVS API base URL for the given region and API type."""

        if not region:
            raise PowerCloudAPIError(
                "_get_api_url: missing region parameter",
                ocf.OCF_ERR_CONFIGURED,
            )

        api_type = str(api_type).lower()
        if api_type not in self._ALLOWED_API_TYPES:
            raise PowerCloudAPIError(
                f"_get_api_url: invalid api_type: '{api_type}', must be one of {self._ALLOWED_API_TYPES}",
                ocf.OCF_ERR_CONFIGURED,
            )
        if api_type == "public" and not self._proxy:
            raise PowerCloudAPIError(
                "_get_api_url: api_type 'public' requires a proxy",
                ocf.OCF_ERR_CONFIGURED,
            )

        subdomain = "private." if api_type == "private" else ""
        return f"https://{subdomain}{region}.{POWER_CLOUD_DOMAIN}"

    def _refresh_token(self):
        """Refresh the bearer token by requesting a new one from the token manager."""
        self._token = self._token_manager.get_token()

    def _get_header(self, crn=""):
        """Construct request header, with an optional per-request CRN override."""
        return {
            "Authorization": f"Bearer {self._token}",
            "CRN": crn,
            "Content-Type": "application/json",
        }

    def send_request(self, method, resource, crn="", json=None):
        """Perform an HTTP API call to the specified resource using the given method.

        The workspace CRN must be supplied via the ``crn`` argument so that the
        correct ``CRN`` header is set for each request.
        """
        url = f"{self._api_url}{resource}"
        parts = crn.split(":") if crn else []
        workspace_id = parts[7] if len(parts) > 7 else ""

        method = method.upper()

        ocf.logger.debug(
            f"[PowerCloudAPI] send_request: '{method}' '{resource}' "
            f"(workspace '{workspace_id}')"
        )

        try:
            request_timeout = (
                REQUESTS_TIMEOUT_WRITE
                if method in {"PUT", "POST"}
                else REQUESTS_TIMEOUT
            )
            for attempt in range(2):
                response = self._session.request(
                    method,
                    url,
                    headers=self._get_header(crn),
                    proxies=self._proxy,
                    timeout=request_timeout,
                    json=json,
                )
                if response.status_code != HTTP_UNAUTHORIZED:
                    break

                if attempt == 0:
                    ocf.logger.warning(
                        f"[PowerCloudAPI] send_request: '{method}' '{resource}' failed: "
                        f"'{response.status_code}', try to refresh token."
                    )
                    self._refresh_token()

            response.raise_for_status()
            return response.json()

        except requests.RequestException as e:
            raise PowerCloudAPIError(
                f"send_request: request error occurred: '{method}' - '{resource}' - '{e}'",
                ocf.OCF_ERR_GENERIC,
            )


class RoutePairError(OCFExitError):
    """Exception class for errors encountered while managing PowerVS network routes."""

    def __init__(self, message, exit_code):
        super().__init__(f"[RoutePairError] {message}", exit_code)


class RoutePair:
    """Provides methods for managing a pair of network routes in Power Virtual Server."""

    def __init__(
        self,
        ip="",
        api_key="",
        api_type="",
        region="",
        route_host_map="",
        use_token_cache="",
        device="",
        iflabel="",
        proxy="",
        profile="",
        atomic="",
        monitor_api="",
    ):
        """Initialize RoutePair instance."""
        local_crn, peer_crn = self._parse_route_map(route_host_map)

        self._api = PowerCloudAPI(
            api_key=api_key,
            api_type=api_type,
            region=region,
            proxy=proxy,
            profile=profile,
            use_cache=str(use_token_cache).lower() == "true",
        )

        self._atomic = str(atomic).lower() == "true"
        self._ip = self._get_ip_info(ip)

        self.routes = RoutePairInfo(
            local=self._get_route_info(local_crn),
            peer=self._get_peer_route_info(peer_crn),
        )

        self.device = self._get_device_name(device)
        self.iflabel = self._make_iflabel(iflabel)

        self.name = f"({self.routes.local.name}, {self.routes.peer.name})"

    def refresh(self, scope=None):
        """Update the route information for the local route, the peer route, or both."""
        scopes = (scope,) if scope is not None else RouteScope

        for route_scope in scopes:
            self.routes[route_scope] = self._refresh_route_info(route_scope)

    def _get_route_info(self, crn):
        """Retrieve and validate attributes of a PowerVS network route."""
        ws_crn, route_id = crn.rsplit(":route:", 1)
        ws_crn = f"{ws_crn}::"

        route_info = self._api.send_request(
            "GET",
            f"/v1/routes/{route_id}",
            crn=ws_crn,
        )

        ocf.logger.debug(f"[RoutePair] _get_route_info: '{route_info}'")

        if self._ip != route_info["destination"]:
            raise RoutePairError(
                f"_get_route_info: IP '{self._ip}' does not match "
                f"the route destination address "
                f"'{route_info['destination']}'",
                ocf.OCF_ERR_CONFIGURED,
            )

        if route_info["advertise"] != "enable":
            raise RoutePairError(
                f"_get_route_info: route '{route_info['name']}' "
                f"advertise flag must be set to enable",
                ocf.OCF_ERR_CONFIGURED,
            )

        return RouteInfo.from_dict(route_info)

    def _get_peer_route_info(self, peer_crn):
        """Retrieve and validate attributes of the peer PowerVS network route.

        When atomic=True, a failure of the GET call is tolerated: the peer route
        data is not required for the switch-enabled POST, which only needs
        peer.crn.  In that case a stub RouteInfo built from the CRN is returned
        and a warning is logged.  When atomic=False the failure is an error, as
        the non-atomic path issues individual PUT calls that depend on full peer
        route state.
        """
        try:
            return self._get_route_info(peer_crn)
        except SystemExit:
            # OCFExitError subclasses call sys.exit() on construction, which
            # raises SystemExit.  Catching it here is intentional: it lets the
            # atomic path tolerate a failing peer-route GET while re-raising
            # immediately on the non-atomic path where full peer state is needed.
            if not self._atomic:
                raise
            ocf.logger.warning(
                f"[RoutePair] _get_peer_route_info: failed to retrieve peer route "
                f"'{peer_crn}'; continuing with stub because atomic=True"
            )
            return RouteInfo.stub_from_crn(peer_crn)

    def _refresh_route_info(self, scope):
        """Update route info."""
        route = self.routes[scope]

        route_info = self._api.send_request(
            "GET",
            f"/v1/routes/{route.route_id}",
            crn=route.ws_crn,
        )
        ocf.logger.debug(f"[RoutePair] _refresh_route_info: '{route_info}'")
        return RouteInfo.from_dict(route_info)

    def _set_route_enabled(self, scope, enabled):
        """Change route state."""
        route = self.routes[scope]

        state = "enabled" if enabled else "disabled"
        ocf.logger.debug(
            f"[RoutePair] _set_route_enabled: update route '{route.name}' to '{state}'"
        )

        self._api.send_request(
            "PUT",
            f"/v1/routes/{route.route_id}",
            crn=route.ws_crn,
            json={"enabled": enabled},
        )

    def is_enabled(self, scope):
        """Verify if route is enabled."""
        return self.routes[scope].state in ROUTE_ACTIVE_STATES

    def is_disabled(self, scope):
        """Verify if route is disabled."""
        return self.routes[scope].state in ROUTE_INACTIVE_STATES

    def _get_ip_info(self, ip):
        """Validate the given IP address and return its standard form."""
        try:
            return str(ipaddress.ip_address(ip))
        except ValueError:
            raise RoutePairError(
                f"_get_ip_info: invalid IP address '{ip}'",
                ocf.OCF_ERR_CONFIGURED,
            )

    def switch_enable(self):
        """Enable the local route, and disable the peer route."""
        local = self.routes.local
        peer = self.routes.peer

        if self._atomic:
            ocf.logger.debug(
                f"[RoutePair] switch_enable: atomically enable "
                f"local route '{local.name}' and disable "
                f"peer route '{peer.name}'"
            )

            self._api.send_request(
                "POST",
                f"/v1/routes/{local.route_id}/switch-enabled",
                crn=local.ws_crn,
                json={"disabledRouteCRN": peer.crn},
            )
            return

        ocf.logger.debug(
            f"[RoutePair] switch_enable: "
            f"disable peer route '{peer.name}', and "
            f"enable local route '{local.name}'"
        )
        self.disable_route(RouteScope.PEER)
        self.enable_route(RouteScope.LOCAL)

    def get_state(self):
        """Get the route state."""
        local = self.routes.local.state
        peer = self.routes.peer.state

        if local == ROUTE_UPDATING or peer == ROUTE_UPDATING:
            return RoutePairState.IN_TRANSIT, f"is transitioning ({local}, {peer})"

        if local == ROUTE_DEPLOYED:
            if peer == ROUTE_DISABLED or peer == ROUTE_UNKNOWN:
                return (
                    RoutePairState.LOCAL_ROUTE_ACTIVE,
                    "has the local route active",
                )
            return (
                RoutePairState.CONFLICT,
                f"has a conflicting state: ({local}, {peer})",
            )
        if local == ROUTE_DISABLED:
            if peer == ROUTE_DISABLED:
                return RoutePairState.INACTIVE, "has both routes inactive"
            if peer == ROUTE_DEPLOYED:
                return (
                    RoutePairState.PEER_ROUTE_ACTIVE,
                    "has the peer route active",
                )
            if peer == ROUTE_UNKNOWN:
                return RoutePairState.INACTIVE, "has local route inactive"

        return RoutePairState.CONFLICT, f"has a conflicting state: ({local}, {peer})"

    def enable_route(self, scope):
        """Enable the PowerVS network route."""
        if not self.is_enabled(scope):
            self._set_route_enabled(scope, True)

    def disable_route(self, scope):
        """Disable the PowerVS network route."""
        if not self.is_disabled(scope):
            self._set_route_enabled(scope, False)

    def disable_local(self):
        """Disable the local route."""
        self.disable_route(RouteScope.LOCAL)

    def enable_local(self):
        """Enable the local route."""
        self.enable_route(RouteScope.LOCAL)

    def _get_device_name(self, name):
        """Verify the existence of a network interface with the specified name."""

        next_hop = self.routes.local.next_hop
        if name:
            if ip_check_device(name, next_hop):
                return name
            raise RoutePairError(
                f"_get_device_name: network interface '{name}' does not exist, "
                f" is down, or does not match with IP address '{next_hop}'",
                ocf.OCF_ERR_CONFIGURED,
            )

        interface_name = ip_find_device(next_hop)
        if interface_name:
            return interface_name

        raise RoutePairError(
            f"_get_device_name: network interface with next hop '{next_hop}' does not exist or is down",
            ocf.OCF_ERR_CONFIGURED,
        )

    def _parse_route_map(self, route_host_map):
        """Return (local_crn, peer_crn) from route_host_map."""
        entries = route_host_map.split(";")

        if len(entries) != 2:
            raise RoutePairError(
                f"Expected exactly two entries in route_host_map: '{route_host_map}'",
                ocf.OCF_ERR_CONFIGURED,
            )

        host_to_crn = {}

        for entry in entries:
            parts = entry.split(":", 1)
            if len(parts) != 2:
                raise RoutePairError(
                    f"Invalid route_host_map entry: '{entry}'",
                    ocf.OCF_ERR_CONFIGURED,
                )
            hostname, crn = parts[0].strip("'\""), parts[1].strip("'\"")

            if hostname in host_to_crn:
                raise RoutePairError(
                    f"Duplicate hostname '{hostname}' in route_host_map",
                    ocf.OCF_ERR_CONFIGURED,
                )

            if not self._is_valid_route_crn(crn):
                raise RoutePairError(
                    f"Invalid CRN for hostname '{hostname}': '{crn}'",
                    ocf.OCF_ERR_CONFIGURED,
                )

            host_to_crn[hostname] = crn

        local_hostname = os.uname().nodename

        try:
            local_crn = host_to_crn[local_hostname]
        except KeyError:
            raise RoutePairError(
                f"Local hostname '{local_hostname}' not found in route_host_map",
                ocf.OCF_ERR_CONFIGURED,
            )

        peer_hostname = next(
            hostname for hostname in host_to_crn if hostname != local_hostname
        )

        return local_crn, host_to_crn[peer_hostname]

    def _make_iflabel(self, label=None):
        """Constructs an interface label in the format 'device:label' if both are provided."""
        if not label:
            return None

        iflabel = f"{self.device}:{label}"

        if len(iflabel) > IFLABEL_MAX_LEN:
            raise RoutePairError(
                f"_make_iflabel: interface label '{iflabel}' exceeds limit of {IFLABEL_MAX_LEN} characters",
                ocf.OCF_ERR_CONFIGURED,
            )

        return iflabel

    def _is_valid_route_crn(self, route_crn):
        """
        Validate that the CRN is a PowerVS route CRN.
        """
        return bool(ROUTE_CRN_PATTERN.match(route_crn))

    def wait_until_deployed(self, deadline):
        """Wait until the local route reaches the deployed state.

        Args:
            deadline (float): Absolute monotonic time (seconds) by which the
                route must be deployed.  The loop stops
                RESOURCE_AGENT_TIMEOUT_BUFFER seconds before this value so
                that the caller has time to perform any cleanup before the
                Pacemaker operation timeout fires.

        Raises:
            RoutePairError: If the deadline is reached before the route is deployed.
        """
        soft_deadline = deadline - RESOURCE_AGENT_TIMEOUT_BUFFER

        while time.monotonic() < soft_deadline:
            try:
                self.refresh(RouteScope.LOCAL)
            except SystemExit:
                # OCFExitError subclasses call sys.exit(), which raises
                # SystemExit.  A transient API failure during the polling loop
                # should not abort the wait — log the failure and retry until
                # the deadline is reached.
                ocf.logger.warning(
                    f"[RoutePair] wait_until_deployed: refresh failed; will retry"
                )
                time.sleep(ROUTE_POLL_INTERVAL)
                continue

            if self.routes.local.state in ROUTE_ACTIVE_STATES:
                ocf.logger.debug(
                    f"[RoutePair] wait_until_deployed: "
                    f"success for local route '{self.routes.local.name}'"
                )
                return

            ocf.logger.debug(
                f"[RoutePair] wait_until_deployed: "
                f"waiting for local route '{self.routes.local.name}' "
                f"(current state: '{self.routes.local.state}')"
            )
            time.sleep(ROUTE_POLL_INTERVAL)

        raise RoutePairError(
            f"wait_until_deployed: timed out waiting for "
            f"local route '{self.routes.local.name}' to reach state 'deployed' "
            f"(current state: '{self.routes.local.state}')",
            ocf.OCF_ERR_GENERIC,
        )


def _filter_resource_options(local_vars):
    """Return a dict restricted to keys defined in RESOURCE_AGENT_OPTIONS.

    NOTE: RESOURCE_AGENT_OPTIONS must be kept in sync with the add_parameter()
    calls in main() and with the parameter signatures of all action functions.
    """
    return {k: v for k, v in local_vars.items() if k in RESOURCE_AGENT_OPTIONS}


def monitor_route_pair(route_pair, ip):
    """Validates the consistency of the local resource state
    - checking the local IP alias
    - checking the local route, and the peer route.
    """

    ip_alias_present = ip_find_device(ip) is not None

    state, state_info = route_pair.get_state()

    if state == RoutePairState.IN_TRANSIT:
        ocf.logger.debug(
            f"[monitor_route_pair]: Route pair '{route_pair.name}' {state_info}"
        )
        if ip_alias_present:
            return ocf.OCF_SUCCESS
        else:
            return ocf.OCF_NOT_RUNNING

    if state == RoutePairState.INACTIVE:
        if ip_alias_present:
            ocf.logger.debug(
                f"[monitor_route_pair]: Route pair '{route_pair.name}' "
                f"{state_info}, but IP alias '{ip}' is active"
            )
            return ocf.OCF_ERR_GENERIC
        ocf.logger.debug(
            f"[monitor_route_pair]: IP alias '{ip}' is not active, "
            f"and route pair '{route_pair.name}' {state_info}"
        )
        return ocf.OCF_NOT_RUNNING

    if state == RoutePairState.LOCAL_ROUTE_ACTIVE:
        if ip_alias_present:
            ocf.logger.debug(
                f"[monitor_route_pair]: IP alias '{ip}' is active, "
                f"and route pair '{route_pair.name}' {state_info}"
            )
            return ocf.OCF_SUCCESS
        ocf.logger.debug(
            f"[monitor_route_pair]: Route pair '{route_pair.name}' "
            f"{state_info}, but IP alias '{ip}' is not active"
        )
        return ocf.OCF_ERR_GENERIC

    # ocf.is_probe() is handled within the base monitor,
    # so PEER_ROUTE_ACTIVE is an error, as well as CONFLICT
    ocf.logger.error(
        f"[monitor_route_pair]: Pair of routes '{route_pair.name}' {state_info}"
    )
    return ocf.OCF_ERR_GENERIC


def start_action(
    ip="",
    api_key="",
    api_type="",
    region="",
    route_host_map="",
    use_token_cache="",
    monitor_api="",
    device="",
    iflabel="",
    proxy="",
    profile="",
    atomic="",
):
    """Assign the service IP.

    This function performs the following actions:
    - Adds the specified IP address as an alias to the given network interface or the interface matching the route's next hop.
    - Disables the peer network route and enables the local network route.
    """
    start_time = time.monotonic()
    timeout_ms = int(os.environ.get("OCF_RESKEY_CRM_meta_timeout", "60000"))
    op_deadline = start_time + timeout_ms / 1000

    resource_options = _filter_resource_options(locals())

    ocf.logger.info("[start_action]: enabling overlay IP")
    ocf.logger.debug(f"[start_action]: options: '{resource_options}'")

    route_pair = RoutePair(**resource_options)

    state, state_info = route_pair.get_state()

    if state == RoutePairState.LOCAL_ROUTE_ACTIVE:
        ocf.logger.info(
            f"[start_action]: local route already active in '{route_pair.name}', "
            "nothing to do"
        )
        return ocf.OCF_SUCCESS

    if state == RoutePairState.INACTIVE:
        route_pair.enable_local()
    else:
        route_pair.switch_enable()

    try:
        ip_alias_add(ip, route_pair.device, route_pair.iflabel)
        route_pair.wait_until_deployed(op_deadline)
    except Exception:
        ocf.logger.error(
            f"[start_action]: failed after enabling route; rolling back IP alias '{ip}'"
        )
        ip_alias_remove(ip)
        raise

    try:
        route_pair.refresh(RouteScope.PEER)
    except SystemExit:
        ocf.logger.warning(
            "[start_action]: failed to refresh peer route state; "
            "continuing without peer route data"
        )
    monitor_result = monitor_route_pair(route_pair, ip)
    if monitor_result != ocf.OCF_SUCCESS:
        raise RoutePairError(
            f"start_action: failed to enable local route in '{route_pair.name}'",
            monitor_result,
        )

    ocf.logger.info(
        f"[start_action]: successfully added IP alias '{ip}', "
        f"and enabled local route in '{route_pair.name}'"
    )
    return ocf.OCF_SUCCESS


def stop_action(
    ip="",
    api_key="",
    api_type="",
    region="",
    route_host_map="",
    use_token_cache="",
    monitor_api="",
    device="",
    iflabel="",
    proxy="",
    profile="",
    atomic="",
):
    """Remove the service IP.

    This function performs the following actions:
    - Disables the network route in the local workspace.
    - Removes the IP alias from the network interface.
    """
    resource_options = _filter_resource_options(locals())

    ocf.logger.info("[stop_action]: disabling overlay IP")
    ocf.logger.debug(f"[stop_action]: options: '{resource_options}'")

    route_pair = RoutePair(**resource_options)
    try:
        route_pair.disable_local()
    finally:
        ip_alias_remove(ip)

    try:
        route_pair.refresh(RouteScope.LOCAL)
    except SystemExit:
        ocf.logger.warning(
            "[stop_action]: failed to refresh local route state; "
            "continuing without updated route data"
        )
    monitor_result = monitor_route_pair(route_pair, ip)
    if monitor_result != ocf.OCF_NOT_RUNNING:
        raise RoutePairError(
            f"stop_action: failed to disable local route in '{route_pair.name}'",
            monitor_result,
        )

    ocf.logger.info(
        f"[stop_action]: successfully removed IP alias '{ip}' "
        f"and disabled local route in '{route_pair.name}'"
    )
    return ocf.OCF_SUCCESS


def monitor_action(
    ip="",
    api_key="",
    api_type="",
    region="",
    route_host_map="",
    use_token_cache="",
    monitor_api="",
    device="",
    iflabel="",
    proxy="",
    profile="",
    atomic="",
):
    """Monitor the service IP and route state.

    Monitoring has two modes:
    - Basic monitor:
      Checks only whether the service IP alias is configured locally.
      This is used for probe operations and when API-backed monitoring is
      disabled.
    - Extended monitor:
      Validates the consistency of the local resource state by checking the
      local IP alias, the local route, and the peer route. This mode is used
      when monitor_api=true.
    """
    resource_options = _filter_resource_options(locals())

    use_base_monitor = str(monitor_api).lower() == "false" or ocf.is_probe()

    ocf.logger.info("[monitor_action]: monitor overlay IP")
    ocf.logger.debug(
        f"[monitor_action]: options: '{resource_options}', is_probe: '{ocf.is_probe()}'"
    )
    #
    # Base monitor

    if use_base_monitor:
        if ip_find_device(ip) is not None:
            ocf.logger.debug(f"[monitor_action]: IP alias '{ip}' is active")
            return ocf.OCF_SUCCESS
        ocf.logger.debug(f"[monitor_action]: IP alias '{ip}' is not active")
        return ocf.OCF_NOT_RUNNING
    #
    # Extended monitor

    route_pair = RoutePair(**resource_options)
    return monitor_route_pair(route_pair, ip)


def validate_all_action(
    ip="",
    api_key="",
    api_type="",
    region="",
    route_host_map="",
    use_token_cache="",
    monitor_api="",
    device="",
    iflabel="",
    proxy="",
    profile="",
    atomic="",
):
    """Validates the provided resource agent options by instantiating the route pair."""
    resource_options = _filter_resource_options(locals())

    ocf.logger.info("[validate_all_action]: validate local and peer routes")
    RoutePair(**resource_options)
    return ocf.OCF_SUCCESS


def main():
    """Instantiate the resource agent."""
    agent = ocf.Agent(
        RESOURCE_AGENT_NAME,
        shortdesc="Manages Power Virtual Server overlay IP routes.",
        longdesc=textwrap.dedent("""\
            Resource Agent to move an IP address from one Power Virtual Server instance to another.

            Prerequisites:
            1. High availability cluster
               - The cluster nodes must be deployed across two Power Virtual Server workspaces located
                 in separate data centers within the same region.
               - The virtual IP can only move between a fixed pair of nodes, with each node residing
                 in a separate workspace.

            2. Predefined static routes
               - Static routes must be configured in both workspaces.
               - Each route must use the service IP as the destination and the corresponding node IP address
                 as the next hop.

            3. IBM Power Cloud API authentication
               - Authentication must be configured using either the Power Virtual Server Metadata service or
                 an IBM Cloud API key (these options are mutually exclusive):
                  - Use a trusted profile with the required privileges for both workspaces, or
                  - Use a service API key with the required privileges for both workspaces, stored locally
                    on the cluster nodes.
               - The trusted profile name or the API key must be referenced in the resource definition.

            For detailed guidance on high availability for SAP applications on PowerVS, visit:
            https://cloud.ibm.com/docs/sap?topic=sap-ha-overview.
        """),
        version=2.0,
    )

    agent.add_parameter(
        "ip",
        shortdesc="IP address",
        longdesc=(
            "The virtual IP address is the destination address of a network route. "
            "Only IPv4 addresses are supported."
        ),
        content_type="string",
        required=True,
    )

    agent.add_parameter(
        "api_key",
        shortdesc="API Key, @API_KEY_FILE, or identity_token",
        longdesc=(
            "IBM Cloud API key, or a file path prefixed with @ containing the API key. "
            "If this parameter is not specified or set to its default value identity_token, "
            "authentication uses the Power Virtual Server Metadata API. "
            "In this case, an IBM Cloud Identity and Access Management (IAM) trusted "
            "profile is used to establish a trust relationship with the virtual server "
            "instance, and the trusted profile can be selected with the profile parameter."
        ),
        content_type="string",
        default="identity_token",
        required=False,
    )

    agent.add_parameter(
        "api_type",
        shortdesc="API type",
        longdesc=(
            "Connection to Power Virtual Server regional endpoints over a public or private network (public|private)."
        ),
        content_type="string",
        default="private",
        required=False,
    )

    agent.add_parameter(
        "region",
        shortdesc="Power Virtual Server region",
        longdesc=(
            "Region that represents the geographic area where the instance is located. "
            "The region is used to identify the Cloud API endpoint."
        ),
        content_type="string",
        required=True,
    )

    agent.add_parameter(
        "route_host_map",
        shortdesc="Mapping of hostnames to IBM Cloud route CRNs",
        longdesc=(
            "Mapping of the hostname of the Power Virtual Server instance to the "
            "route CRN of the overlay IP route. Separate the hostname and route CRN "
            "with a colon ':', separate different hostname and route CRN pairs with a semicolon ';'. "
            "Exactly two entries are allowed. "
            "Example: hostname1:route-crn-of-instance1;hostname2:route-crn-of-instance2"
        ),
        content_type="string",
        required=True,
    )

    agent.add_parameter(
        "use_token_cache",
        shortdesc="API token caching",
        longdesc=(
            "Caching of the API access token in a local file to reduce authentication overhead. "
        ),
        content_type="string",
        default="True",
        required=False,
    )

    agent.add_parameter(
        "monitor_api",
        shortdesc="Enhanced API Monitoring",
        longdesc=(
            "Enhanced monitoring by using Power Cloud API calls to verify route configuration correctness. "
        ),
        content_type="string",
        default="False",
        required=False,
    )

    agent.add_parameter(
        "device",
        shortdesc="Network adapter for the overlay IP address",
        longdesc=(
            "Network adapter for the overlay IP address. "
            "The adapter must have the same name on all Power Virtual Server instances. "
            "If the `device` parameter is not specified, the IP alias is assigned to the "
            "interface whose configured IP address matches the route's next hop address. "
        ),
        content_type="string",
        default="",
        required=False,
    )

    agent.add_parameter(
        "iflabel",
        shortdesc="Network interface label",
        longdesc=(
            "A custom suffix for the IP address label. "
            "It is appended to the interface name in the format device:label. "
            "The full label must not exceed 15 characters. "
        ),
        content_type="string",
        required=False,
    )

    agent.add_parameter(
        "proxy",
        shortdesc="Proxy",
        longdesc=(
            "Proxy server used to access IBM Cloud API endpoints. "
            "The value must be a valid URL in the format 'http[s]://hostname:port'. "
        ),
        content_type="string",
        default="",
        required=False,
    )

    agent.add_parameter(
        "profile",
        shortdesc="Trusted profile name or id",
        longdesc=(
            "Trusted profile associated with the instance for authorization using the metadata API. "
            "Use 'id:PROFILE_ID' to select a profile by id or "
            "'name:PROFILE_NAME' to select a profile by name. "
            "If not specified, the default trusted profile is used."
        ),
        content_type="string",
        default="",
        required=False,
    )

    agent.add_parameter(
        "atomic",
        shortdesc="Atomic update of the route pair",
        longdesc=("Atomically enable one route and disable another."),
        content_type="string",
        default="False",
        required=False,
    )

    agent.add_action(
        "start", timeout=RESOURCE_AGENT_START_TIMEOUT, handler=start_action
    )
    agent.add_action("stop", timeout=RESOURCE_AGENT_STOP_TIMEOUT, handler=stop_action)
    agent.add_action(
        "monitor",
        depth=0,
        timeout=RESOURCE_AGENT_MONITOR_TIMEOUT,
        interval=RESOURCE_AGENT_INTERVAL,
        handler=monitor_action,
    )
    agent.add_action(
        "validate-all",
        timeout=RESOURCE_AGENT_MONITOR_TIMEOUT,
        handler=validate_all_action,
    )

    agent.run()


if __name__ == "__main__":
    main()
