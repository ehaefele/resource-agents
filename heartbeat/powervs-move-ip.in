IP_CMD = "/usr/sbin/ip"
CIDR_NETMASK = "32"
IFLABEL_MAX_LEN = 15  # Maximum character limit for interface labels
REQUESTS_CONNECT_TIMEOUT = 5  # TCP connection timeout for HTTP requests (seconds)
REQUESTS_READ_TIMEOUT_SHORT = (
    30  # Read timeout for token/metadata and route GET calls (seconds)
)
REQUESTS_READ_TIMEOUT_LONG = 60  # Read timeout for route PUT/POST calls (seconds)
REQUESTS_TIMEOUT = (
    REQUESTS_CONNECT_TIMEOUT,
    REQUESTS_READ_TIMEOUT_SHORT,
)  # default: (connect, read)
REQUESTS_TIMEOUT_WRITE = (
    REQUESTS_CONNECT_TIMEOUT,
    REQUESTS_READ_TIMEOUT_LONG,
)  # for route PUT/POST: (connect, read)
HTTP_MAX_RETRIES = 4  # Maximum number of retries for HTTP requests
HTTP_BACKOFF_FACTOR = 0.3  # Sleep (factor * (2^number of previous retries)) secs
HTTP_STATUS_FORCE_RETRIES = (429, 500, 502, 503, 504)  # HTTP status codes to retry on
HTTP_RETRY_ALLOWED_METHODS = frozenset({"GET", "POST", "PUT", "DELETE"})
HTTP_UNAUTHORIZED = 401
POWER_CLOUD_DOMAIN = "power-iaas.cloud.ibm.com"
IAM_CLOUD_DOMAIN = "iam.cloud.ibm.com"

ROUTE_DEPLOYED = "deployed"
ROUTE_DISABLED = "disabled"
ROUTE_UPDATING = "updating"
ROUTE_UNKNOWN = "unknown"

ROUTE_ACTIVE_STATES = {ROUTE_DEPLOYED}
ROUTE_INACTIVE_STATES = {ROUTE_DISABLED}


class RouteScope(Enum):
    LOCAL = "local"
    PEER = "peer"


class RouteInfo:
    def __init__(
        self, crn, name, state, destination, advertise, next_hop, enabled, raw
    ):
        self.crn = crn
        self.name = name
        self.state = state
        self.destination = destination
        self.advertise = advertise
        self.next_hop = next_hop
        self.enabled = enabled
        self.raw = raw
        # Derived from crn once at construction — avoids re-parsing on every API call.
        workspace_crn, self.route_id = crn.rsplit(":route:", 1)
        self.ws_crn = f"{workspace_crn}::"

    @classmethod
    def from_dict(cls, d):
        """Construct a RouteInfo from a raw API response dict."""
        return cls(
            crn=d["crn"],
            name=d["name"],
            state=d["state"].lower(),
            destination=d["destination"],
            advertise=d["advertise"],
            next_hop=d["nextHop"],
            enabled=d["enabled"],
            raw=d,
        )

    @classmethod
    def stub_from_crn(cls, crn):
        """Construct a minimal RouteInfo stub from a CRN when the GET call is unavailable.

        Only the crn field is populated with real data.  All other fields carry
        neutral sentinel values so that the atomic switch-enabled path, which only
        needs peer.crn, can proceed without error.
        """
        _, route_id = crn.rsplit(":route:", 1)
        return cls(
            crn=crn,
            name=route_id,
            state=ROUTE_UNKNOWN,
            destination="",
            advertise="",
            next_hop="",
            enabled=False,
            raw={},
        )


class RoutePairInfo:
    def __init__(self, local, peer):
        self.local = local
        self.peer = peer

    def __getitem__(self, scope):
        if scope == RouteScope.LOCAL:
            return self.local
        if scope == RouteScope.PEER:
            return self.peer
        raise KeyError(f"Unknown RouteScope: {scope!r}")

    def __setitem__(self, scope, route):
        if scope == RouteScope.LOCAL:
            self.local = route
        elif scope == RouteScope.PEER:
            self.peer = route
        else:
            raise KeyError(f"Unknown RouteScope: {scope!r}")


class RoutePairState(IntEnum):
    """States describing the combined enabled/disabled status of a route pair."""

    INACTIVE = 0
    LOCAL_ROUTE_ACTIVE = 1
    PEER_ROUTE_ACTIVE = 2
    IN_TRANSIT = 3
    CONFLICT = 4


ROUTE_CRN_PATTERN = re.compile(
    r"^crn:v1:"
    r"(?P<env>[^:]+):"
    r"public:"
    r"power-iaas:"
    r"(?P<region>[^:]+):"
    r"a/(?P<account_id>[^:]+):"
    r"(?P<workspace_id>[0-9a-fA-F-]{36}):"
    r"route:"
    r"(?P<route_id>[0-9a-fA-F-]{36})$"
)


